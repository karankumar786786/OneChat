{
  "name": "chat-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev && prisma generate",
    "db:deploy": "prisma migrate deploy",
    "contracts": "bun scripts/generate-openapi.ts",
    "s3:lifecycle": "bun scripts/s3-lifecycle.ts",
    "test": "bun test --timeout 20000"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1175.0",
    "@aws-sdk/s3-presigned-post": "3.1175.0",
    "@aws-sdk/s3-request-presigner": "3.1175.0",
    "@hono/zod-openapi": "1.6.3",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@socket.io/bun-engine": "0.1.2",
    "@socket.io/redis-adapter": "8.3.0",
    "bullmq": "6.7.8",
    "expo-server-sdk": "8.0.0",
    "hono": "4.13.20",
    "ioredis": "6.0.0",
    "jose": "6.2.18",
    "pino": "10.4.0",
    "rate-limiter-flexible": "11.5.0",
    "socket.io": "4.8.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/bun": "1.4.5",
    "pino-pretty": "13.2.0",
    "prisma": "7.10.1",
    "socket.io-client": "4.8.4",
    "typescript": "7.0.2"
  }
}
