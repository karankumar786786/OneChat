NODE_ENV=development
PORT=4000
# Comma-separated list of allowed origins for CORS (the Expo app does not need CORS).
CORS_ORIGINS=*

DATABASE_URL=postgresql://chat:chat@localhost:5433/chat
REDIS_URL=redis://localhost:6380

# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

S3_BUCKET=
S3_REGION=ap-south-1
# Leave empty for real AWS S3. Set to e.g. http://localhost:9000 for an S3-compatible local store.
S3_ENDPOINT=
# Only for a local S3-compatible store: the address phones use (e.g. http://192.168.1.20:9000).
S3_PUBLIC_ENDPOINT=
S3_FORCE_PATH_STYLE=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

FILE_TTL_DAYS=30
STATUS_TTL_HOURS=24
MAX_FILE_MB=100

# Optional: Expo access token for push notifications (https://expo.dev/accounts/[account]/settings/access-tokens)
EXPO_ACCESS_TOKEN=
